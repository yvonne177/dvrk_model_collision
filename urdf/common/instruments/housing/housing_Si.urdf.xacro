<?xml version="1.0" encoding="utf-8"?>
<robot name="dvrk_instrument_housing_si" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find dvrk_model)/urdf/common.urdf.xacro"/>

  <xacro:macro name="housing_Si" params="prefix variant:=default">
    <xacro:property name="visual_mesh" value="${dict(default='housing_Si.obj', clinical='housing_Si_clinical.obj', training='housing_Si.obj')[str(variant)]}"/>
    <joint name="${prefix}housing_fixed" type="fixed">
      <parent link="${prefix}adaptor_link"/>
      <child link="${prefix}housing_link"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    </joint>

    <link name="${prefix}housing_link">
      <visual>
        <origin rpy="0.0 ${-PI_2} ${PI_2}" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/instruments/housing/Si/${visual_mesh}"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0.0 ${-PI_2} ${PI_2}" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/instruments/housing/Si/housing_Si.obj"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

</robot>
