        </geometry>
        <material name="collision_red"><color rgba="1.0 0.0 0.0 1.0"/></material>
      </collision>
      <collision name="jaw_1_collision_09">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://dvrk_model/meshes/instruments/tip/006/collision_hulls/tip_006_1_convex_hull_09.obj"/>
        </geometry>
        <material name="collision_red"><color rgba="1.0 0.0 0.0 1.0"/></material>
      </collision>

    </link>

    <joint name="jaw_2" type="revolute">
