        <geometry>
          <mesh filename="package://dvrk_model/meshes/instruments/tip/006/collision_hulls/tip_006_1_convex_hull_06.obj"/>
        </geometry>
        <material name="collision_red"><color rgba="1.0 0.0 0.0 1.0"/></material>
      </collision>
      <collision name="jaw_1_collision_07">
